# ── Never commit ──────────────────────────────────────────────
# Build / package output
/target/
/dist/
**/*.pdb
*.exe
!packaging/**

# Local reference clones (third-party / huge)
/vendor/
/reference/

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & crash dumps
*.log
crash.log
*.dmp

# Secrets / local env (never ship)
.env
.env.*
*.pem
*.key
auth.json
**/auth.json
**/credentials*
**/secrets*

# Local app data accidentally copied into repo
/attachments/
/sessions_index.json

# Scratch / one-off agent scripts
/scripts/_*.py
/tmp/
/.cache/
*.tmp

# Optional local overrides
/config.local.*
*.local.toml
*.local.json
